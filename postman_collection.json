{
  "info": {
    "name": "Library Management API",
    "description": "RESTful API for Library Management System — Spring Boot",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" }
  ],
  "item": [
    {
      "name": "Authors",
      "item": [
        {
          "name": "Get All Authors",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/authors"
          }
        },
        {
          "name": "Search Authors",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/authors?search=ილია"
          }
        },
        {
          "name": "Get Author by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/authors/1"
          }
        },
        {
          "name": "Create Author",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/authors",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"ნინო\",\n  \"lastName\": \"ჰაიდარი\",\n  \"biography\": \"თანამედროვე ქართველი მწერალი\"\n}"
            }
          }
        },
        {
          "name": "Update Author",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/authors/1",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"შოთა\",\n  \"lastName\": \"რუსთაველი\",\n  \"biography\": \"XII საუკუნის დიდი ქართველი პოეტი\"\n}"
            }
          }
        },
        {
          "name": "Delete Author",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/authors/4"
          }
        }
      ]
    },
    {
      "name": "Books",
      "item": [
        {
          "name": "Get All Books",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/books"
          }
        },
        {
          "name": "Get Available Books",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/books?available=true"
          }
        },
        {
          "name": "Search Books by Title",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/books?title=ვეფხ"
          }
        },
        {
          "name": "Filter by Genre",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/books?genre=Fantasy"
          }
        },
        {
          "name": "Get Book by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/books/1"
          }
        },
        {
          "name": "Get Book by ISBN",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/books/isbn/978-9941-0-0001-1"
          }
        },
        {
          "name": "Get Books by Author",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/books/author/2"
          }
        },
        {
          "name": "Create Book",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/books",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"ახალი ეპოქა\",\n  \"isbn\": \"978-9941-0-8888-8\",\n  \"publishedYear\": 2023,\n  \"genre\": \"რომანი\",\n  \"authorId\": 1\n}"
            }
          }
        },
        {
          "name": "Update Book",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/books/1",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"ვეფხისტყაოსანი (გამოცემა)\",\n  \"isbn\": \"978-9941-0-0001-1\",\n  \"publishedYear\": 1200,\n  \"genre\": \"პოეზია\",\n  \"authorId\": 1\n}"
            }
          }
        },
        {
          "name": "Delete Book",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/books/5"
          }
        }
      ]
    },
    {
      "name": "Borrows",
      "item": [
        {
          "name": "Get All Records",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/borrows"
          }
        },
        {
          "name": "Get Active Loans",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/borrows?active=true"
          }
        },
        {
          "name": "Search by Borrower",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/borrows?borrower=გიო"
          }
        },
        {
          "name": "Borrow a Book",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/borrows",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"borrowerName\": \"გიორგი ბერიძე\",\n  \"bookId\": 1\n}"
            }
          }
        },
        {
          "name": "Return a Book",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/borrows/return/1"
          }
        }
      ]
    }
  ]
}
